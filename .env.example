# Optional first-run administrator provisioning (minimum 14 characters; remove after creation)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Default uses local H2. Configure all DATABASE_* variables to use PostgreSQL.
DATABASE_URL=jdbc:h2:file:./data/cybercase;MODE=PostgreSQL;AUTO_SERVER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver

# Optional authorized URLhaus API key; without it verification remains UNCONFIGURED.
URLHAUS_API_KEY=
